# =====================================================================
#  АЛТЫН КЕСЕ — переменные окружения
#  Скопируйте этот файл в .env и заполните свои значения:
#    cp .env.example .env
# =====================================================================

# ─── Проброс портов (какие порты слушает хост) ──────────────────────────
SITE_HTTP_PORT=80
DB_PORT=3307              # Порт MySQL на хосте (внутри контейнеров всегда 3306)
BOT_WEBHOOK_PORT=3017     # На нём бот принимает уведомления о выигрыше (3007 может быть занят)

# ─── База данных ────────────────────────────────────────────────────────
DB_HOST=db
DB_NAME=kese
DB_USER=kese
DB_PASSWORD=change_me_strong_password
DB_ROOT_PASSWORD=change_me_root_password

# ─── Приватный токен между сервисами (bot/sheets ↔ api) ─────────────────
# Любая длинная случайная строка. Сгенерируйте: openssl rand -hex 32
API_INTERNAL_TOKEN=replace_me_with_64_hex_chars

# ─── Telegram bot ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=8658521320:AAGmzTBs7vMHWlyyKzSFN4e0BeJ0sjeQUs0
# Админы бота (через запятую)
BOT_ADMIN_IDS=7630329150,435582277,978276180

# ─── Бизнес-настройки по умолчанию (потом можно менять /settings в ТГ) ──
TICKET_PRICE=12000
EXPECTED_IIN=870317400041
KASPI_URL=https://pay.kaspi.kz/pay/crisd5hz

# ─── Публичный URL сайта (для ссылок на игру из бота) ───────────────────
SITE_PUBLIC_URL=https://qazaq-tea.com/kese

# Внутренний URL API из контейнера бота / sheets-sync
API_INTERNAL_URL=http://api/kese

# ─── Админ-панель ───────────────────────────────────────────────────────
ADMIN_PASSWORD=KeseAdmin2025!
# IP, которым разрешён вход БЕЗ пароля (через запятую, поддерживается CIDR)
ADMIN_ALLOWED_IPS=194.87.138.14
# 1 = только по IP (без пароля), 0 = пароль + IP
ADMIN_IP_ONLY=0

# ─── Google Sheets sync ─────────────────────────────────────────────────
