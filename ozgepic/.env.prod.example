# =====================================================================
#  OZGEPIC — PRODUCTION .env (отдельный VPS, домен ozgepic.kz)
#  Скопируйте в .env и замените значения, помеченные <ЗАПОЛНИТЕ>.
#  Сгенерировать пароли/токены:
#    openssl rand -hex 32
# =====================================================================

# ─── Публикация портов на хосте ────────────────────────────────────────
SITE_BIND=127.0.0.1
SITE_HTTP_PORT=8080
DB_PORT=3307
BOT_WEBHOOK_PORT=3017

# ─── Let's Encrypt / nginx-proxy ───────────────────────────────────────
DOMAIN=ozgepic.kz
EXTRA_DOMAINS=www.ozgepic.kz
LETSENCRYPT_EMAIL=<ваш email>

# ─── База данных ───────────────────────────────────────────────────────
DB_HOST=db
DB_NAME=ozgepic
DB_USER=ozgepic
DB_PASSWORD=<ЗАПОЛНИТЕ: openssl rand -hex 24>
DB_ROOT_PASSWORD=<ЗАПОЛНИТЕ: openssl rand -hex 24>

# ─── Приватный токен между сервисами ───────────────────────────────────
API_INTERNAL_TOKEN=<ЗАПОЛНИТЕ: openssl rand -hex 32>
API_INTERNAL_URL=http://api/kese

# ─── Telegram bot ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<токен от @BotFather>
BOT_ADMIN_IDS=435582277

# ─── Бизнес-настройки ──────────────────────────────────────────────────
TICKET_PRICE=16900
EXPECTED_IIN=<ИИН/БИН продавца>
KASPI_URL=https://pay.kaspi.kz/pay/<ваш-код>

# ─── Публичные URL ─────────────────────────────────────────────────────
SITE_PUBLIC_URL=https://ozgepic.kz

# ─── Админ-панель ──────────────────────────────────────────────────────
ADMIN_PASSWORD=<ЗАПОЛНИТЕ: openssl rand -hex 16>
ADMIN_ALLOWED_IPS=
ADMIN_IP_ONLY=0

# ─── Google Sheets sync ────────────────────────────────────────────────
GSHEETS_SPREADSHEET_ID=<ID таблицы>
GSHEETS_SHEET_NAME=Sheet1
GSHEETS_INTERVAL_MS=600000
